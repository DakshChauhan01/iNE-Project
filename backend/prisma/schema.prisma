generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id                       Int            @id @default(autoincrement())
  name                     String
  store_url                String         @unique
  store_product_id         String
  image_url                String?
  is_active                Boolean        @default(true)
  scrape_frequency_minutes Int            @default(120)
  created_at               DateTime       @default(now())
  
  price_histories          PriceHistory[]
  scrape_logs              ScrapeLog[]
  alerts                   Alert[]
  
  @@map("products")
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  product_id Int
  price      Float?
  currency   String   @default("INR")
  in_stock   Boolean
  scraped_at DateTime @default(now())
  method     String   // 'browser' or 'http'
  
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model ScrapeLog {
  id                Int      @id @default(autoincrement())
  product_id        Int
  started_at        DateTime @default(now())
  finished_at       DateTime
  status            String   // 'success' | 'retried' | 'failed'
  attempt_count     Int
  duration_ms       Int
  method_used       String
  error_message     String?
  structure_changed Boolean  @default(false)
  
  product           Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("scrape_log")
}

model Alert {
  id           Int       @id @default(autoincrement())
  product_id   Int
  type         String    // 'price_drop' or 'back_in_stock'
  threshold    Float?
  email        String
  created_at   DateTime  @default(now())
  triggered_at DateTime?
  
  product      Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("alerts")
}
